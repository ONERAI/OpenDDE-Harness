# npm 12 refuses git dependencies unless asked (allow-git defaults to "none").
# `pi-codex-compact` -- the Codex server-side compaction algorithms, pinned by
# commit in package.json -- is published only as a git repository, so `npm ci`
# fails with EALLOWGIT without this. "root" allows it for this project alone:
# a dependency of a dependency still cannot pull from git.
allow-git=root
