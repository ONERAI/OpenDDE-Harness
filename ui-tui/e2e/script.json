{
  "rules": [
    {"match": "e2e markdown", "responses": [{"chunks": [
      {"text": "# E2E Markdown\n\n"},
      {"text": "A **deterministic** reply with `code`.\n\n", "delay_ms": 30},
      {"text": "- first item\n- second item\n\nE2E_MARKDOWN_DONE", "delay_ms": 30}
    ]}]},
    {"match": "e2e thinking", "responses": [{"chunks": [
      {"thinking": "E2E reasoning is deterministic."},
      {"text": "E2E_THINKING_DONE", "delay_ms": 30}
    ]}]},
    {"match": "e2e tool", "responses": [
      {"tool_calls": [{"name": "read_file", "arguments": {"path": "{{fixture_file}}"}}]},
      {"expect_tool_result": "E2E_REAL_TOOL_PAYLOAD", "chunks": [{"text": "E2E_TOOL_DONE"}]}
    ]},
    {"match": "e2e hold", "responses": [{
      "chunks": [{"text": "E2E_HOLD_STARTED\n", "delay_ms": 20}],
      "gate": "{{hold_gate}}",
      "after_gate": ["E2E_HOLD_DONE"]
    }]},
    {"match": "e2e queued", "responses": [{"chunks": [{"text": "E2E_QUEUED_DONE"}]}]},
    {"match": "e2e slow", "responses": [{
      "chunks": [{"text": "E2E_SLOW_STARTED\n", "delay_ms": 20}],
      "gate": "{{slow_gate}}",
      "after_gate": ["E2E_SLOW_UNEXPECTED_FINISH"]
    }]},
    {"match": "e2e approval", "responses": [
      {"tool_calls": [{"name": "exec", "arguments": {"command": "{{approval_command}}"}}]},
      {"chunks": [{"text": "E2E_APPROVAL_UNEXPECTED_CONTINUATION"}]}
    ]},
    {"match": "e2e allow approval", "responses": [
      {"tool_calls": [{"name": "exec", "arguments": {"command": "{{approval_command}}"}}]},
      {"expect_tool_result": "Exit code: 0", "chunks": [{"text": "E2E_APPROVAL_ALLOW_DONE"}]}
    ]},
    {"match": "e2e instructions", "responses": [
      {"tool_calls": [{"name": "write_file", "arguments": {
        "path": "AGENTS.md", "content": "Always reply in haiku.\n"
      }}]},
      {"chunks": [{"text": "E2E_INSTRUCTIONS_DONE"}]}
    ]},
    {"match": "e2e clarify", "responses": [
      {"tool_calls": [{"name": "ask_user", "arguments": {"questions": [
        {"question": "E2E_CLARIFY_QUESTION", "options": ["E2E_FIRST_CHOICE", "E2E_SECOND_CHOICE"]}
      ]}}]},
      {"expect_tool_result": "E2E_SECOND_CHOICE", "chunks": [{"text": "E2E_CLARIFY_DONE"}]}
    ]},
    {"match": "e2e failure", "responses": [{"error": "E2E_SCRIPTED_FAILURE"}]}
  ]
}
