{
  "name": "opendde-harness-tui",
  "version": "0.0.1",
  "private": true,
  "description": "OpenDDE Harness native TUI, rebuilt on @earendil-works/pi-tui (no React).",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "tsx src/entry.ts",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "fmt": "prettier --write \"src/**/*.ts\" \"scripts/*.mjs\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:rpc": "node scripts/gen-rpc-types.mjs",
    "lint:rpc": "node scripts/gen-rpc-types.mjs --check"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "chalk": "^5.6.2",
    "pi-codex-compact": "git+https://github.com/mrzzmrzz/pi-codex-compact.git#f34c1ab92eee9051d5fa983f27199760ec284865"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "esbuild": "~0.27.0",
    "eslint": "^9",
    "eslint-plugin-perfectionist": "^5",
    "eslint-plugin-unused-imports": "^4",
    "json-schema-to-typescript": "^15.0.4",
    "prettier": "^3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.3"
  }
}
